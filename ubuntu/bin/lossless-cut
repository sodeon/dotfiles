#!/bin/bash -ue

if [[ $# -lt 2 ]]; then
    echo "Usage: ${0##*/} <file name> <start1> [<end1> <start2> <end2> ...]"
    echo
    echo "Lossless cut video into multiple segments using ffmpeg"
    echo "If the last start time has no end time, it cuts to the end of the file."
    echo "Time format: H[H]:M[M]:S[S]"
    echo
    echo "Example:"
    echo "  ${0##*/} somevideo.mp4 0:1:30 0:6:4 0:10:00 0:12:30"
    echo "  ${0##*/} somevideo.mp4 0:1:30 0:6:4 0:15:00"
    exit 1
fi

input_file="$1"
name="${input_file%.*}"
ext="${input_file##*.}"
shift

while [[ $# -gt 0 ]]; do
    start="$1"
    end="${2-}"

    if [[ -z "$end" ]]; then
        output_file="${name}-${start//:/_}.${ext}"
        ffmpeg -i "$input_file" -ss "$start" -vcodec copy -acodec copy "$output_file"
        shift 1
    else
        output_file="${name}-${start//:/_}-${end//:/_}.${ext}"
        ffmpeg -i "$input_file" -ss "$start" -to "$end" -vcodec copy -acodec copy "$output_file"
        shift 2
    fi
done


